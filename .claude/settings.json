{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn install)",
      "Bash(yarn install --frozen-lockfile)",
      "Bash(yarn dev)",
      "Bash(yarn build)",
      "Bash(yarn start)",
      "Bash(yarn test)",
      "Bash(yarn lint)",
      "Bash(yarn type-check)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --staged)",
      "Bash(git log --oneline)",
      "Bash(git log --oneline -20)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git fetch origin)",
      "Bash(gh pr view)",
      "Bash(gh pr list)",
      "Bash(gh pr checks)",
      "Bash(gh pr diff)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push origin deploy-prep:*)",
      "Bash(git push origin HEAD:deploy-prep:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  }
}
