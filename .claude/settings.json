{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn install)",
      "Bash(yarn install --frozen-lockfile)",
      "Bash(yarn dev)",
      "Bash(yarn build)",
      "Bash(yarn start)",
      "Bash(yarn test)",
      "Bash(yarn test:*)",
      "Bash(yarn lint)",
      "Bash(yarn type-check)",
      "Bash(yarn vitest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push origin deploy-prep:*)",
      "Bash(git push origin HEAD:deploy-prep:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
