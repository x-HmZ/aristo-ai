# Aristo AI: environment variables
#
# Copy this file to .env.local for local development. On Vercel, set each value in Project Settings ->
# Environment Variables. .env.local is gitignored: never commit real values, and never paste a real key into
# this file, an issue, a PR or a chat.
#
# Server-only secrets must NOT start with NEXT_PUBLIC_: anything with that prefix is baked into the browser
# bundle and visible to every visitor.
#
# Legend
#   [required]  the app (or `yarn build`) needs it. A dummy value is enough to build and to open / and /demo.
#   [optional]  leave empty or commented out; the feature degrades or switches off.
#   [paid]      calls a metered API. Real keys come from the owner. Do not run paid generations to "just test"
#               without the owner's go-ahead (see CONTRIBUTING.md, "Paid APIs").
#   [auto]      set by Node or Vercel; do not set it yourself.
#
# Skip locally: everything under Billing (off by default, sandbox-only), FAL_KEY unless you work on image/3D
# generation, OPENAI_API_KEY (RAG and server voice input only), ElevenLabs unless you work on speech, Resend,
# Turnstile, operator details, Avaturn.
# =============================================================================================================

# -- Supabase (auth + database) --------------------------------------------------------------------------------
# Where: from the owner (Supabase dashboard -> Project Settings -> API). Without real values sign-in, /learn,
# /admin and every API route that reads the database fail; / and /demo still work.
# [required] Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# [required] Public anon key (safe in the browser; Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [required, secret] Service-role key. Server-only. Bypasses Row Level Security, and also seeds the HMAC that
# signs quiz and narration tokens (src/lib/guard/sign.ts). Never expose it, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# -- Anthropic (lessons, quizzes, chat) ----------------------------------------------------------------------
# [required, paid, secret] Where: from the owner, or your own key at console.anthropic.com if agreed.
# Model IDs live only in src/lib/agents/models.ts: never hardcode them elsewhere.
ANTHROPIC_API_KEY=

# -- OpenAI (RAG embeddings, optional server voice input) ---------------------------------------------------
# [optional, paid, secret] text-embedding-3-small for RAG, and /api/stt when NEXT_PUBLIC_STT_ENGINE=server.
# Without it RAG is skipped gracefully and voice input uses the browser.
OPENAI_API_KEY=
# [optional] Voice input engine: "browser" (default, Web Speech API; in Chrome the audio goes to Google) or
# "server" (records in the browser, transcribes through /api/stt with OPENAI_API_KEY, about 0.003 USD/min).
# NEXT_PUBLIC_STT_ENGINE=browser

# -- ElevenLabs (teacher speech) -----------------------------------------------------------------------------
# [optional, paid, secret] /api/tts. Without it speech falls back to the browser's Web Speech voice.
ELEVENLABS_API_KEY=
# [optional] "paid" switches Jake to the Mike voice on eleven_multilingual_v2 (src/lib/tts/voices.json).
# Unset or anything else = free tier (placeholder voice on turbo; library voices are refused on free).
# After changing it, re-run scripts/prerender-demo-tts.mjs: /demo's narration is recorded in advance.
# ELEVENLABS_PLAN=
# [optional] USD per 1,000 narrated characters, for the cost pages and per-user usage rows. 0.11 is an
# assumption: replace it with the rate of the ElevenLabs plan in use.
# ELEVENLABS_USD_PER_1K_CHARS=0.11
# [optional] Lesson narration is cached in the public generated-assets bucket after its first play
# (migration 019). "off" skips character timings (lipsync falls back to the FFT) and caches plain audio.
# TTS_TIMESTAMPS=
# [optional] "browser" forces Web Speech for the teacher's voice. Leave unset for the default.
# NEXT_PUBLIC_TTS=

# -- fal.ai (image + 3D generation) --------------------------------------------------------------------------
# [optional, paid, secret] FLUX -> Tripo3D models and Nano Banana images in lessons. Only needed when you work
# on generation; without it lessons run with no generated image or model. The name is FAL_KEY, NOT FAL_API_KEY.
FAL_KEY=

# -- Email (Resend): admin "new sign-up" notifications ---------------------------------------------------------
# [optional, secret] Without it no email is sent; sign-up still works.
RESEND_API_KEY=
# [optional] Where "new sign-up" emails go. Use a role address you control.
ADMIN_NOTIFY_EMAIL=
# [optional] Override the From address. Defaults to Resend's sandbox domain.
# RESEND_FROM="Aristo AI <noreply@your-verified-domain.com>"

# -- Site URL --------------------------------------------------------------------------------------------------
# [optional] Public origin for links in emails, canonical/Open Graph URLs, sitemap and robots.txt.
# Order used: APP_URL, then NEXT_PUBLIC_APP_URL, then Vercel's hosts, then http://localhost:3000.
# Pin APP_URL on production for stable links.
# APP_URL=https://aristo.example.com
# NEXT_PUBLIC_APP_URL=
# [auto] VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL (Vercel) and NODE_ENV (Next.js). Do not set them.

# -- Public feature flags (visible in the browser) ---------------------------------------------------------------
# [optional] Avaturn subdomain for /create-teacher. Empty = /create-teacher answers 404 and custom teacher URLs
# are refused.
NEXT_PUBLIC_AVATURN_SUBDOMAIN=
# [optional] Segment-based adaptive visuals ("true"/"false").
NEXT_PUBLIC_ADAPTIVE_VISUALS=true
# [optional] Interactive visuals (V10): generated, sandboxed widgets. Off unless "true". Gates the agents'
# option and /api/learn/interactive; "false" plus a redeploy is the kill switch.
NEXT_PUBLIC_INTERACTIVE_VISUALS=false
# [optional] Dev harness pages (/dev/*) answer 404 in a production build. "true" at build time keeps them
# (only for capture scripts against a local production build; never in a deployed environment).
# NEXT_PUBLIC_DEV_PAGES=false

# -- Billing (migration 021): sandbox-only, off by default ---------------------------------------------------
# Skip all of this locally. Each flag accepts only "true" or "false". With everything off there is no checkout
# and no portal, every /api/billing route answers 404, and usage is not limited.
# BILLING_ENABLED=false
# Count usage per account and answer 402 at a plan's limit (independent of BILLING_ENABLED).
# ENFORCE_ALLOWANCE=false
# Paddle (merchant of record). Required when BILLING_ENABLED=true; no default. Payments are sandbox-only:
# keep "sandbox". "live" is refused unless BILLING_ALLOW_LIVE=true, which stays false.
# PADDLE_ENVIRONMENT=sandbox
# BILLING_ALLOW_LIVE=false
# [secret] Server key (sandbox keys start with pdl_sdbx_apikey_); needs customer_portal_session.write.
# PADDLE_API_KEY=
# Browser token for Paddle.js (sandbox tokens start with test_). Sent only to a signed-in account owner.
# PADDLE_CLIENT_TOKEN=
# [secret] Secret of the notification destination that points at /api/billing/webhook.
# PADDLE_WEBHOOK_SECRET=
# Days a past-due subscription keeps its paid plan (0 to 30).
# BILLING_GRACE_DAYS=7
# "Contact us" on /pricing is clickable only when set. Use a role address, not a personal one.
# NEXT_PUBLIC_CONTACT_EMAIL=
# Shows "prices are provisional" on /pricing until set to false.
# NEXT_PUBLIC_PRICES_PROVISIONAL=true

# -- Spend guard (migration 023) ------------------------------------------------------------------------------
# [optional] When today's logged spend (UTC) passes this, paid generations answer 503 "paused_for_today";
# cached lessons and everything free keep working. Platform admins are not stopped. Default 5.
# DAILY_SPEND_LIMIT_USD=5
# [optional] The same ceiling per signed-in user (429 "daily_limit_reached"). Default 1.
# USER_DAILY_SPEND_LIMIT_USD=1

# -- Access and sign-up (migration 025) ------------------------------------------------------------------------
# [optional] "approval" (default): every new account waits for an admin. "open": a user with a confirmed
# email and recorded consents gets in without approval. Only the exact word "open" opens the door.
# Set both to the same value; the NEXT_PUBLIC twin only switches a sentence on the landing page.
# ACCESS_MODE=approval
# NEXT_PUBLIC_ACCESS_MODE=approval
# [optional] Cloudflare Turnstile on sign-up. Inert unless both are set. The secret is server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# -- Operator details for the legal pages ----------------------------------------------------------------------
# [optional] /privacy, /terms, /imprint and /parents show "Draft, not yet in force" and stay out of search
# engines until name, town and contact address are set. Production values live in Vercel only: never commit
# them here.
# NEXT_PUBLIC_OPERATOR_NAME=
# NEXT_PUBLIC_OPERATOR_TOWN=
# NEXT_PUBLIC_OPERATOR_COUNTRY=Austria
# The imprint needs a postal address once the service is commercial.
# NEXT_PUBLIC_OPERATOR_ADDRESS=

# -- Local scripts only (never read by the app) ------------------------------------------------------------------
# scripts/room/verify-room.mjs: Chrome binary, target server, "alt" room, and UNCAP=1 to lift the frame cap.
# CHROME="C:/Program Files/Google/Chrome/Application/chrome.exe"
# BASE_URL=http://localhost:3000
# ROOM=
# UNCAP=
# scripts/eval-3d-models.ts: output folder for the paid model comparison (needs FAL_KEY and approval).
# EVAL_OUT_DIR=
