# Aristo AI — environment variables
# Copy this file to .env.local for local dev. For Vercel, add each value
# in Project Settings → Environment Variables. .env.local is gitignored —
# never commit real values to this repo.
#
# Server-only secrets must NOT be prefixed with NEXT_PUBLIC_, or they will
# be embedded in the client bundle and leak to every visitor.
# =============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server-only. Bypasses RLS — guard ruthlessly.
SUPABASE_SERVICE_ROLE_KEY=

# ── Model providers ─────────────────────────────────────────────────────────
# Anthropic — teaching + assessment (Sonnet 5) and fast paths (Haiku 4.5).
# Model IDs are centralized in src/lib/agents/models.ts — never hardcode
# elsewhere.
ANTHROPIC_API_KEY=
# OpenAI — RAG embeddings (text-embedding-3-small)
OPENAI_API_KEY=
# ElevenLabs — premium TTS route at /api/tts. Optional; falls back to Web Speech.
ELEVENLABS_API_KEY=
# ElevenLabs plan: "paid" switches Jake to Mike on eleven_multilingual_v2 (src/lib/tts/voices.json).
# Unset or anything else = free (placeholder voice on turbo; library voices are refused on free).
# After changing it, re-run scripts/prerender-demo-tts.mjs: /demo's narration is recorded in advance.
# ELEVENLABS_PLAN=
# What one thousand narrated characters cost you in USD, for the cost pages and per-user usage rows.
# 0.11 is an assumption: replace it with the rate of your own ElevenLabs plan.
# ELEVENLABS_USD_PER_1K_CHARS=0.11
# Lesson narration is cached in the public generated-assets bucket after its first play (migration 019).
# TTS_TIMESTAMPS=off skips character timings (lipsync falls back to the FFT) and then caches plain audio.
# TTS_TIMESTAMPS=
# Voice input engine: "browser" (default, the Web Speech API: in Chrome the audio goes to Google) or "server"
# (records in the browser, transcribes through /api/stt with OPENAI_API_KEY, about 0.003 USD per minute).
# NEXT_PUBLIC_STT_ENGINE=browser
# fal.ai — image + 3D generation pipeline (FLUX → Tripo3D, Nano Banana Pro).
# Note: env name is FAL_KEY, NOT FAL_API_KEY.
FAL_KEY=

# ── Email (Resend) — admin approval notifications ───────────────────────────
RESEND_API_KEY=
# Where "new signup" emails are delivered.
ADMIN_NOTIFY_EMAIL=
# Optional: override the From address. Defaults to Resend's sandbox domain.
# RESEND_FROM="Aristo AI <noreply@your-verified-domain.com>"

# ── Deployment ──────────────────────────────────────────────────────────────
# Base URL for absolute links in emails. On Vercel this is auto-derived
# from VERCEL_URL if not set, but pin it on production for stable links.
# APP_URL=https://aristo.example.com

# ── Public feature flags (safe to expose to the browser) ────────────────────
# Avaturn avatar generation iframe subdomain.
NEXT_PUBLIC_AVATURN_SUBDOMAIN=
# Toggle segment-based adaptive visuals (true/false).
NEXT_PUBLIC_ADAPTIVE_VISUALS=true
# Interactive visuals (V10): generated, sandboxed widgets. Off unless "true". Gates the agents' option and
# /api/learn/interactive; flip to "false" and redeploy to switch the feature off everywhere.
NEXT_PUBLIC_INTERACTIVE_VISUALS=false
# TTS engine preference ("browser" forces Web Speech). Leave unset for default.
# NEXT_PUBLIC_TTS=
# Dev harness pages (/dev/*) answer 404 in a production build. Set to "true" at build time to keep them
# (only for capture scripts against a production build; never in a deployed environment).
# NEXT_PUBLIC_DEV_PAGES=false

# ── Plans, allowances and billing (migration 021) ───────────────────────────
# Each flag accepts only "true" or "false". Everything is off by default: no checkout, no portal, every
# /api/billing route answers 404, and usage is not limited.
# BILLING_ENABLED=false
# Count usage per account and answer 402 at a plan's limit (independent of BILLING_ENABLED).
# ENFORCE_ALLOWANCE=false
# Paddle is the merchant of record. Required when BILLING_ENABLED=true; there is no default.
# "live" is refused unless BILLING_ALLOW_LIVE=true: do not set that until you may legally take payments.
# PADDLE_ENVIRONMENT=sandbox
# BILLING_ALLOW_LIVE=false
# Server key (sandbox keys start with pdl_sdbx_apikey_); needs customer_portal_session.write.
# PADDLE_API_KEY=
# Browser token for Paddle.js (sandbox tokens start with test_). Sent only to a signed-in account owner.
# PADDLE_CLIENT_TOKEN=
# Secret of the notification destination that points at /api/billing/webhook.
# PADDLE_WEBHOOK_SECRET=
# Days a past-due subscription keeps its paid plan (0 to 30).
# BILLING_GRACE_DAYS=7
# "Contact us" on /pricing is clickable only when this is set. Use a role address, not a personal one.
# NEXT_PUBLIC_CONTACT_EMAIL=
# Shows "prices are provisional" on /pricing until set to false.
# NEXT_PUBLIC_PRICES_PROVISIONAL=true

# ── Spend guard (migration 023) ─────────────────────────────────────────────
# When today's logged spend (UTC) passes this, paid generations answer 503 "paused_for_today";
# cached lessons and everything free keep working. Platform admins are not stopped.
# DAILY_SPEND_LIMIT_USD=5
# The same ceiling per signed-in user (429 "daily_limit_reached").
# USER_DAILY_SPEND_LIMIT_USD=1

# ── Access and sign-up (migration 025) ──────────────────────────────────────
# "approval" (default): every new account waits for an admin. "open": a user with a confirmed email and
# recorded consents gets in without approval. Only the exact word "open" opens the door.
# Set both to the same value; the NEXT_PUBLIC twin only switches a sentence on the landing page.
# ACCESS_MODE=approval
# NEXT_PUBLIC_ACCESS_MODE=approval
# Optional Cloudflare Turnstile on sign-up. Inert unless both are set.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Operator details for the legal pages ────────────────────────────────────
# /privacy, /terms, /imprint and /parents show "Draft, not yet in force" and stay out of search engines
# until the name, town and contact address are set. Never commit real values here.
# NEXT_PUBLIC_OPERATOR_NAME=
# NEXT_PUBLIC_OPERATOR_TOWN=
# NEXT_PUBLIC_OPERATOR_COUNTRY=Austria
# The imprint needs a postal address once the service is commercial.
# NEXT_PUBLIC_OPERATOR_ADDRESS=
