# Aristo AI — environment variables
# Copy this file to .env.local for local dev. For Vercel, add each value
# in Project Settings → Environment Variables. .env.local is gitignored —
# never commit real values to this repo.
#
# Server-only secrets must NOT be prefixed with NEXT_PUBLIC_, or they will
# be embedded in the client bundle and leak to every visitor.
# =============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server-only. Bypasses RLS — guard ruthlessly.
SUPABASE_SERVICE_ROLE_KEY=

# ── Model providers ─────────────────────────────────────────────────────────
# Anthropic — teaching + assessment (Sonnet 5) and fast paths (Haiku 4.5).
# Model IDs are centralized in src/lib/agents/models.ts — never hardcode
# elsewhere.
ANTHROPIC_API_KEY=
# OpenAI — RAG embeddings (text-embedding-3-small) + Whisper STT route
OPENAI_API_KEY=
# Google AI — reserved for planned PDF/generative endpoints. Not currently
# read by any route (the @google/generative-ai dependency is installed but
# unwired); safe to leave blank until that lands.
GOOGLE_AI_KEY=
# ElevenLabs — premium TTS route at /api/tts. Optional; falls back to Web Speech.
ELEVENLABS_API_KEY=
# fal.ai — image + 3D generation pipeline (FLUX → Tripo3D, Nano Banana Pro).
# Note: env name is FAL_KEY, NOT FAL_API_KEY.
FAL_KEY=

# ── Email (Resend) — admin approval notifications ───────────────────────────
RESEND_API_KEY=
# Where "new signup" emails are delivered.
ADMIN_NOTIFY_EMAIL=
# Optional: override the From address. Defaults to Resend's sandbox domain.
# RESEND_FROM="Aristo AI <noreply@your-verified-domain.com>"

# ── Deployment ──────────────────────────────────────────────────────────────
# Base URL for absolute links in emails. On Vercel this is auto-derived
# from VERCEL_URL if not set, but pin it on production for stable links.
# APP_URL=https://aristo.example.com

# ── Public feature flags (safe to expose to the browser) ────────────────────
# Avaturn avatar generation iframe subdomain.
NEXT_PUBLIC_AVATURN_SUBDOMAIN=
# Toggle segment-based adaptive visuals (true/false).
NEXT_PUBLIC_ADAPTIVE_VISUALS=true
# TTS engine preference ("browser" forces Web Speech). Leave unset for default.
# NEXT_PUBLIC_TTS=
